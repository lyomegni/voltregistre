# Supabase (projet en région UE, ex. eu-west-3 Paris)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : uniquement côté serveur (cron des alertes, webhook Stripe)
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brevo (e-mails d'alerte)
BREVO_API_KEY=
ALERT_SENDER_EMAIL=alertes@voltregistre.fr

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MULTISITES=
STRIPE_PRICE_PRESTATAIRE=
# Prix "5 € par site client" (quantité = nombre de sites)
STRIPE_PRICE_PRESTATAIRE_SITE=

# Secret partagé pour l'appel du cron (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
